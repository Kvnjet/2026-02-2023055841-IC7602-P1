# --- DNS API ---
DNS_API_PORT=8080

# --- Servidor DNS remoto ---
REMOTE_DNS_SERVER=8.8.8.8
REMOTE_DNS_PORT=53
UDP_TIMEOUT_MS=2000

# --- Firebase ---
DB_PROVIDER=firebase
# Emulador: http://host.docker.internal:9000
# Producción: https://p1-redes-a87a7-default-rtdb.firebaseio.com
DB_URL=http://host.docker.internal:9000
# Emulador: cualquier valor (ej. fake-api-key). Producción: Web API Key del proyecto
DB_API_KEY=fake-api-key
# Emulador: http://host.docker.internal:9099. Producción: dejar vacío
FIREBASE_AUTH_URL=http://host.docker.internal:9099
# Emulador: p1-redes-a87a7-default-rtdb. Producción: dejar vacío
FIREBASE_DATABASE_NAMESPACE=p1-redes-a87a7-default-rtdb
# Usuario de Firebase Auth exclusivo del DNS API
FIREBASE_EMAIL=
FIREBASE_PASSWORD=
