{
  "rules": {
    ".read": false,
    ".write": false,

    "dnsRecords": {
      ".read": "auth != null",
      ".indexOn": ["hostname", "enabled"]
    },

    "healthCheckers": {
      ".read": "auth != null",
      "$checkerId": {
        ".write": "auth != null && auth.uid === $checkerId"
      }
    },

    "healthResults": {
      ".read": "auth != null",
      "$recordId": {
        "$targetId": {
          "$checkerId": {
            ".write": "auth != null && auth.uid === $checkerId"
          }
        }
      }
    }
  }
}